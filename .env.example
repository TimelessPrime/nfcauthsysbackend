# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER COMPOSE
# ==========================================

# Token xác thực bắt tay giữa ESP32 và Backend (phải khớp với firmware ESP32)
AUTH_TOKEN=systemauth

# Cấu hình Cơ sở dữ liệu MySQL
MYSQL_ROOT_PASSWORD=2000
MYSQL_DATABASE=nfc_attendance

# Múi giờ Việt Nam (+07:00)
TZ=Asia/Ho_Chi_Minh

# Cấu hình Discord Bot (Tùy chọn nếu không cấu hình qua config/bot_config.json)
# DISCORD_BOT_ENABLED=true
# DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
# DISCORD_GUILD_ID=YOUR_GUILD_ID
# DISCORD_STATUS_CHANNEL_ID=
# DISCORD_NOTI_CHANNEL_ID=
# DISCORD_REG_CHANNEL_ID=
# DISCORD_INFO_CHANNEL_ID=
# DISCORD_STATUS_INTERVAL_MINUTES=5
# DISCORD_STATUS_UPDATE_MODE=edit
